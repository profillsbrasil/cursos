{
  "name": "@cursos/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:copiar-producao": "bash scripts/copiar-producao.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:migrate:local": "drizzle-kit migrate --config drizzle.local.config.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/seed/index.ts",
    "db:start": "docker run -d --rm --name cursos-postgres -p 54322:5432 -e POSTGRES_PASSWORD=postgres postgres:18-alpine",
    "db:stop": "docker stop cursos-postgres",
    "db:studio": "drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cursos/config": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
