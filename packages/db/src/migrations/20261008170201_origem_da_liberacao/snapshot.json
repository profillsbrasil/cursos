    {
      "value": "\"user_id\" ~ '^user_[A-Za-z0-9]+$'",
      "name": "liberacao_user_id_clerk",
      "entityType": "checks",
      "schema": "public",
      "table": "liberacao"
    },
    {
      "value": "num_nonnulls(\"trilha_id\", \"curso_id\") = 1",
      "name": "liberacao_alvo_unico",
      "entityType": "checks",
      "schema": "public",
      "table": "liberacao"
    },
    {
      "value": "(\"revogada_em\" is null) = (\"revogada_por\" is null)\n          and (\"revogada_em\" is null or \"revogada_em\" >= \"liberada_em\")",
      "name": "liberacao_revogacao_coerente",
      "entityType": "checks",
      "schema": "public",
      "table": "liberacao"
    },
    {
      "value": "\"revogada_em\" is null or \"origem\"::text <> 'troca'",
      "name": "liberacao_troca_nao_revoga",
      "entityType": "checks",
      "schema": "public",
      "table": "liberacao"
    },
    {
      "value": "\"origem\"::text <> 'troca'\n          or (\"liberada_por\" = \"user_id\" and \"curso_id\" is not null)",
      "name": "liberacao_troca_pelo_aluno",
      "entityType": "checks",
      "schema": "public",
      "table": "liberacao"
    },
    {
      "value": "\"posicao\" >= 1",
      "name": "aula_posicao_positiva",
      "entityType": "checks",
      "schema": "public",
      "table": "aula"
    },
    {
      "value": "\"duracao_seg\" > 0",
      "name": "aula_duracao_positiva",
      "entityType": "checks",
      "schema": "public",
      "table": "aula"
    },
    {
      "value": "(\"video_provedor\" is null) = (\"video_id\" is null)",
      "name": "aula_video_completo",
      "entityType": "checks",
      "schema": "public",
      "table": "aula"
    },
    {
      "value": "\"video_provedor\" is null or case \"video_provedor\"\n            when 'youtube' then \"video_id\" ~ '^[A-Za-z0-9_-]{11}$'\n            else false\n          end",
      "name": "aula_video_formato",
      "entityType": "checks",
      "schema": "public",
      "table": "aula"
    },
