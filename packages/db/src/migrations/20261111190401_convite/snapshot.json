    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "convite",
        "name": "convite_email_formato",
        "value": "\"email\" = lower(btrim(\"email\"))\n          and char_length(\"email\") <= 254\n          and \"email\" ~ '^[^@[:space:]]+@[^@[:space:]]+\\.[^@[:space:]]+$'",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "convite",
        "name": "convite_convidado_por_clerk",
        "value": "\"convidado_por\" ~ '^user_[A-Za-z0-9]+$'",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "convite",
        "name": "convite_envio_coerente",
        "value": "(\"enviado_em\" is null) = (\"clerk_convite_id\" is null)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "convite",
        "name": "convite_aceite_coerente",
        "value": "(\"aceito_em\" is null) = (\"aceito_por\" is null)\n          and (\"aceito_por\" is null or \"aceito_por\" ~ '^user_[A-Za-z0-9]+$')",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "convite",
        "name": "convite_cancelamento_coerente",
        "value": "(\"cancelado_em\" is null) = (\"cancelado_por\" is null)",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "convite",
        "name": "convite_um_fim_so",
        "value": "\"aceito_em\" is null or \"cancelado_em\" is null",
        "entityType": "checks"
      }
    },
    {
      "op": "create",
      "row": {
        "schema": "public",
        "table": "convite",
        "name": "convite_papel_aplicado_coerente",
        "value": "\"papel_aplicado_em\" is null or (\"como_admin\" and \"aceito_em\" is not null)",
