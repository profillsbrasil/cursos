    {
      "op": "alter",
      "key": "enums\u0000[\"public\",\"motivo_ponto\"]",
      "set": {
        "values": [
          "aula_assistida",
          "concessao",
          "curso_concluido",
          "questionario",
          "sequencia_7_dias",
          "troca"
        ]
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"ponto_lancamento\",\"ponto_lancamento_referencia\"]",
      "set": {
        "value": "num_nonnulls(\"aula_id\", \"concessao_id\", \"curso_id\", \"dia_marco\", \"liberacao_id\", \"tentativa_id\") = 1\n          and case \"motivo\"::text\n            when 'aula_assistida' then \"aula_id\" is not null\n            when 'concessao' then \"concessao_id\" is not null\n            when 'curso_concluido' then \"curso_id\" is not null\n            when 'questionario' then \"tentativa_id\" is not null\n            when 'sequencia_7_dias' then \"dia_marco\" is not null\n            when 'troca' then \"liberacao_id\" is not null\n            else false\n          end"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"ponto_lancamento\",\"ponto_lancamento_sinal\"]",
      "set": {
        "value": "case \"motivo\"::text\n            when 'troca' then \"pontos\" < 0\n            when 'concessao' then \"pontos\" <> 0\n            else \"pontos\" > 0\n          end"
      }
    }
