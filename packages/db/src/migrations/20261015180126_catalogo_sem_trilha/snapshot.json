      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"ponto_lancamento\",\"ponto_lancamento_referencia\"]",
      "set": {
        "value": "num_nonnulls(\"aula_id\", \"curso_id\", \"dia_marco\", \"liberacao_id\") = 1\n          and case \"motivo\"\n            when 'aula_assistida' then \"aula_id\" is not null\n            when 'curso_concluido' then \"curso_id\" is not null\n            when 'sequencia_7_dias' then \"dia_marco\" is not null\n            when 'troca' then \"liberacao_id\" is not null\n            else false\n          end"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"ponto_lancamento\",\"ponto_lancamento_sinal\"]",
      "set": {
        "value": "case \"motivo\" when 'troca' then \"pontos\" < 0 else \"pontos\" > 0 end"
      }
    },
    {
      "op": "alter",
      "key": "checks\u0000[\"public\",\"liberacao\",\"liberacao_troca_pelo_aluno\"]",
      "set": {
        "value": "\"origem\"::text <> 'troca' or \"liberada_por\" = \"user_id\""
      }
