{
  "name": "cursos",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "@types/node": "^26.6.6",
      "varlock": "1.25.0",
      "lucide-react": "^1.75.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "@trpc/server": "^11.29.4",
      "@trpc/client": "^11.29.4",
      "@clerk/backend": "^3.30.0",
      "@tailwindcss/postcss": "^4.3.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5",
      "recharts": "3.11.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "coletar-orfaos": "bun run --cwd packages/api coletar-orfaos",
    "db:copiar-producao": "bun run --cwd packages/db db:copiar-producao",
    "db:generate": "turbo run db:generate -F @cursos/db --",
    "db:migrate": "turbo run db:migrate -F @cursos/db --",
    "db:push": "turbo run db:push -F @cursos/db --",
    "db:start": "bun run --cwd packages/db db:start",
    "db:stop": "bun run --cwd packages/db db:stop",
    "db:studio": "turbo run db:studio -F @cursos/db --",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "test": "turbo run test",
    "virada-dos-pontos": "bun run --cwd packages/api virada-dos-pontos"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@2.0.1"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cursos/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "railway": "^3.17.0",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "ultracite": "8.3.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
