{
  "name": "cursos",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^7.0.2",
      "@types/node": "^26.4.1",
      "varlock": "1.21.1",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@trpc/server": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "@clerk/backend": "^3.17.1",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "recharts": "3.10.1"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @cursos/db --",
    "db:migrate": "turbo run db:migrate -F @cursos/db --",
    "db:push": "turbo run db:push -F @cursos/db --",
    "db:start": "bun run --cwd packages/db db:start",
    "db:stop": "bun run --cwd packages/db db:stop",
    "db:studio": "turbo run db:studio -F @cursos/db --",
    "deploy": "bunx vercel deploy",
    "deploy:check": "bunx vercel deploy --dry",
    "deploy:prod": "bunx vercel deploy --prod",
    "deploy:setup": "bunx vercel link",
    "dev": "turbo run dev",
    "dev:vercel": "bunx vercel dev -L",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cursos/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
