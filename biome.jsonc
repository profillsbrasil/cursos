{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    // Protótipos aprovados: HTML de referência, que ninguém roda. As permissões locais
    // do Claude Code ficam fora do git (gitignore global) e o Biome não lê esse ignore.
    // O config do detector do impeccable é reescrito pela CLI dele a cada ignore.
    "includes": [
      "!!docs/prototipos",
      "!!.claude/settings.local.json",
      "!!.impeccable/config.json"
    ]
  },
  // Regras que o ultracite 8.1 e 8.2 ligaram e que o código de hoje não segue.
  "linter": {
    "rules": {
      "complexity": {
        // As três ocorrências comparam Date ou string, onde Math.min e Math.max
        // devolvem número ou NaN.
        "useMathMinMax": "off"
      },
      "style": {
        // getElementById lê o id exato; querySelector pediria CSS.escape nos ids
        // do useId e dos alvos do editor.
        "useDomQuerySelector": "off",
        // Nomear os grupos não muda o que as regex fazem e reescreveria 178 grupos.
        "useNamedCaptureGroup": "off",
        // A flag u muda o que ., \w com i e as classes negadas casam, e recusa
        // escapes que hoje valem: 409 regex mudariam de semântica.
        "useUnicodeRegex": "off"
      },
      "suspicious": {
        // O único ciclo é index.ts -> consultas/* -> index.ts pelo ErroParaAPessoa.
        "noImportCycles": "off",
        // scrollbar-color, scrollbar-width e ::selection são enfeite: o navegador
        // que não os conhece ignora a declaração.
        "useBaseline": "off"
      }
    }
  },
  "overrides": [
    {
      // O test() criado no laço lê o let que o beforeAll preenche: roda depois, de propósito.
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": { "rules": { "suspicious": { "noLoopFunc": "off" } } }
    },
    {
      // shadcn output is regenerated by `shadcn add`, and public/ holds static assets.
      "includes": [
        "packages/ui/src/components/**",
        "packages/ui/src/hooks/**",
        "packages/ui/src/lib/utils.ts",
        "apps/web/public/**"
      ],
      "linter": { "enabled": false }
    },
    {
      // Cerca do admin: o banco só chega ao app por um Context de contextoDe.
      // Um Server Action com o db na mão grava sem passar pelo adminProcedure.
      "includes": ["apps/web/**", "!apps/web/public/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cursos/db",
                      "@cursos/db/**",
                      "**/packages/db/**"
                    ],
                    "message": "Só src/services.ts importa @cursos/db. Leia e grave pelo caller de src/server/api.ts."
                  },
                  {
                    "group": ["@/services", "**/services"],
                    "message": "Só src/context.ts e src/server/api.ts importam os serviços. Use os carregadores de src/server/api.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/services.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/services", "**/services"],
                    "message": "Só src/context.ts e src/server/api.ts importam os serviços."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/context.ts", "apps/web/src/server/api.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@cursos/db",
                      "@cursos/db/**",
                      "**/packages/db/**"
                    ],
                    "message": "Só src/services.ts importa @cursos/db."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
