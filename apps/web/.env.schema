# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=string(minLength=1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# @type=string(minLength=1)
CLERK_SECRET_KEY=

# @public @type=string(minLength=1)
CLERK_PUBLISHABLE_KEY=

# A origem do app não é segredo: o Clerk só aceita o token emitido para ela. Na
# Railway, é https://cursos.profills.com.
# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# O bucket S3 das capas (o "capas" da Railway: ENDPOINT, REGION, BUCKET,
# ACCESS_KEY_ID e SECRET_ACCESS_KEY dele). Sem uma das cinco, o envio de capa recusa.
# Endpoint, região e nome não são segredo, e a região "auto" aparece em todo JS.
# @required=false @sensitive=false @type=url
S3_ENDPOINT=

# @required=false @sensitive=false @type=string(minLength=1)
S3_REGION=

# @required=false @sensitive=false @type=string(minLength=1)
S3_BUCKET=

# @required=false @type=string(minLength=1)
S3_ACCESS_KEY_ID=

# @required=false @type=string(minLength=1)
S3_SECRET_ACCESS_KEY=

# O bucket S3 do material de apoio (o "materiais" da Railway: BUCKET, ACCESS_KEY_ID
# e SECRET_ACCESS_KEY dele). O endpoint e a região são os de S3_ENDPOINT e
# S3_REGION, que a Railway dá iguais a todo bucket. Sem uma das três (ou sem o
# endpoint e a região), o envio de material recusa e o resto funciona.
# @required=false @sensitive=false @type=string(minLength=1)
S3_MATERIAIS_BUCKET=

# @required=false @type=string(minLength=1)
S3_MATERIAIS_ACCESS_KEY_ID=

# @required=false @type=string(minLength=1)
S3_MATERIAIS_SECRET_ACCESS_KEY=
