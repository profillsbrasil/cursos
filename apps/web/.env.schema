# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=string(minLength=1)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# @type=string(minLength=1)
CLERK_SECRET_KEY=

# @public @type=string(minLength=1)
CLERK_PUBLISHABLE_KEY=

# A origem do app não é segredo: o Clerk só aceita o token emitido para ela. Na
# Railway, a variável do serviço é https://${{RAILWAY_PUBLIC_DOMAIN}}.
# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# O bucket S3 das capas (o "capas" da Railway: ENDPOINT, REGION, BUCKET,
# ACCESS_KEY_ID e SECRET_ACCESS_KEY dele). Sem uma das cinco, o envio de capa recusa.
# @required=false @type=url
S3_ENDPOINT=

# @required=false @type=string(minLength=1)
S3_REGION=

# @required=false @type=string(minLength=1)
S3_BUCKET=

# @required=false @type=string(minLength=1)
S3_ACCESS_KEY_ID=

# @required=false @type=string(minLength=1)
S3_SECRET_ACCESS_KEY=
